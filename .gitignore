# The user database holds emails and password hashes: keep it out of git.
tradelab.db
tradelab.db-journal
tradelab.db-wal
tradelab.db-shm

__pycache__/
*.pyc
.DS_Store
node_modules/

# HTTPS certificates and private keys: never commit them.
# (serve.py keeps the ones it makes in ~/.tradelab/certs, outside this folder.)
*.pem
*.key
